{
  "manifest_version": 3,
  "name": "KVKK Kalkanı",
  "version": "0.1.0",
  "description": "Yapay zekâya gönderilen mesajlardaki kişisel verileri bilgisayarınızda maskeler; cevapta geri çevirir.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "KVKK Kalkanı" }
}
